# Copy to terraform.tfvars for local use; keep real values out of Git.
# Use the same project_name and aws_region in infrastructure.
# Storage automatically publishes bucket metadata in AWS SSM after configuring S3.
# This root module requires no cluster, Cognito, Kubernetes or Helm configuration.
aws_region     = "us-east-1"
project_name   = "my-cluster"
s3_bucket_name = "qualitypro-docs"

# Keep false for normal deployments. This setting belongs only to storage.
# Apply true before intentionally destroying buckets and all their object versions.
s3_force_destroy = false
